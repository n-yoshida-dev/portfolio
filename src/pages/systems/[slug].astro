---
// Systems 詳細。開いた直後に見えるのは要約・要点・構成要素だけにし、本文は FoldedBody が畳む（全文は Markdown 版が持つ）。
import { render, getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FoldedBody from '../../components/FoldedBody.astro';

export async function getStaticPaths() {
  const systems = await getCollection('systems');
  return systems.map((system) => ({ params: { slug: system.id }, props: { system } }));
}

const { system } = Astro.props;
const d = system.data;
const { Content } = await render(system);
const related = await getCollection('projects', (p) => p.data.systems.includes(system.id));
---

<Base title={d.title} description={d.summary} markdownHref={`/systems/${system.id}.md`}>
  <p class="meta">
    <a href="/systems">Systems</a> /
  </p>
  <h1>{d.title}</h1>
  <p class="lead">{d.summary}</p>
  {d.components.length > 0 && (
    <ul class="tag-list" aria-label="構成要素">
      {d.components.map((c) => (
        <li>{c}</li>
      ))}
    </ul>
  )}

  <FoldedBody highlights={d.highlights}>
    <Content />
  </FoldedBody>

  {related.length > 0 && (
    <>
      <h2>関連するプロジェクト</h2>
      <p class="inline-links">
        {related
          .sort((a, b) => a.data.order - b.data.order)
          .map((p) =>
            (p.body ?? '').trim() ? (
              <a href={`/projects/${p.id}`}>{p.data.title}</a>
            ) : (
              <span>{p.data.title}</span>
            ),
          )}
      </p>
    </>
  )}
</Base>
