---
// Skills。public-profile/skills.md を描画する（Phase 1 は手動管理）。
// 先に区分ごとのカード（見出し・区分の定義・項目名・根拠のリンク）を出し、本文は「項目ごとの説明と根拠を読む」に畳む（SPEC.md §4）。
// カードは本文から取り出すので、文章を 2 か所で持たない。本文の表は .kv-tables の CSS で「ラベル + 値」に積み替える（Markdown 版は表のまま）
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/content';
import { skillOverview } from '../lib/outline';

const page = await getPage('skills');
const { Content } = await render(page);
const { cards, note } = skillOverview(page.body ?? '');
---

<Base title={page.data.title} description={page.data.description} markdownHref="/skills.md">
  <h1>{page.data.title}</h1>
  <p class="lead">{page.data.description}</p>
  <ul class="card-grid skill-cards">
    {cards.map((c) => (
      <li class="card">
        <h2>{c.title}</h2>
        {c.definition && <p class="skill-def">{c.definition}</p>}
        <ul class="skill-items">
          {c.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        {c.evidence.length > 0 && (
          <p class="skill-evidence">
            根拠：
            {c.evidence.map((e, i) => (
              <>
                {i > 0 && '、'}
                <a href={e.href}>{e.label}</a>
              </>
            ))}
          </p>
        )}
      </li>
    ))}
  </ul>
  {note.length > 0 && (
    <p class="skill-note">{note.map((s) => (s.href ? <a href={s.href}>{s.text}</a> : s.text))}</p>
  )}
  <details class="more">
    <summary>項目ごとの説明と根拠を読む</summary>
    <div class="prose kv-tables">
      <Content />
    </div>
  </details>
  <p class="meta">最終確認日: {page.data.updated}</p>
</Base>
