---
// Skills。public-profile/skills.md をそのまま描画する（Phase 1 は手動管理）。
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/content';

const page = await getPage('skills');
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description} markdownHref="/skills.md">
  <h1>{page.data.title}</h1>
  <p class="lead">{page.data.description}</p>
  <div class="prose">
    <Content />
  </div>
  <p class="meta">最終確認日: {page.data.updated}</p>
</Base>
