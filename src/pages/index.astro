---
// トップ。「何の人か」「何を作っているか」「どう仕組み化しているか」を 1 画面で伝える。
// 文章は frontmatter の tagline / highlights だけを出し、profile.md の本文は Markdown 版（/profile.md）に任せる。
import Base from '../layouts/Base.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { getPage, getFeaturedProjects, getSystems } from '../lib/content';
import { SITE } from '../site';

const profile = await getPage('profile');
const featured = (await getFeaturedProjects()).slice(0, 3);
const systems = await getSystems();
---

<Base description={profile.data.description} markdownHref="/profile.md">
  <h1>{SITE.name}</h1>
  {profile.data.tagline && <p class="lead">{profile.data.tagline}</p>}
  {profile.data.highlights && (
    <ul class="highlights">
      {profile.data.highlights.map((h) => (
        <li>{h}</li>
      ))}
    </ul>
  )}
  {profile.data.links && (
    <p class="inline-links">
      {profile.data.links.map((l) => (
        <a href={l.url}>{l.label}</a>
      ))}
    </p>
  )}

  <div class="intro-grid">
    <div>
      <h2>
        <a href="/projects">Projects</a>
      </h2>
      <p>何を作ったか。業務アプリ、自分のためのツール、開発の道具</p>
    </div>
    <div>
      <h2>
        <a href="/systems">Systems</a>
      </h2>
      <p>それらをどう組み合わせて、開発・学習・生活を仕組み化しているか</p>
    </div>
    <div>
      <h2>
        <a href="/ask">Ask AI</a>
      </h2>
      <p>あなたの AI に私のことを調べさせるためのプロンプト</p>
    </div>
  </div>

  <h2>主なプロジェクト</h2>
  <ul class="entry-list">
    {featured.map((p) => (
      <ProjectItem project={p} compact />
    ))}
  </ul>
  <p>
    <a href="/projects">すべてのプロジェクト →</a>
  </p>

  <h2>仕組み</h2>
  <p class="inline-links">
    {systems.map((s) => (
      <a href={`/systems/${s.id}`}>{s.data.title}</a>
    ))}
  </p>
  <p class="meta">最終確認日: {profile.data.updated}</p>
</Base>
