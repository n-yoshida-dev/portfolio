---
// Ask AI の入口。ボタンを押すと（PC はマウスを乗せても）各 AI を選ぶメニューが開き、/ask に移らずに訪問者の AI を開ける（SPEC.md §3・§4）。
// 開け閉めは HTML の popover（popovertarget）に任せ、JavaScript は使わない。外を押すか Esc で閉じる。
// JavaScript は Gemini のプロンプトのコピーだけ（Gemini は URL でプロンプトを渡せないため）。
import { buildAskPrompt, chatLinks } from '../lib/ask';
import { ASK_BUTTON_LABEL } from '../site';

interface Props {
  /** fab：右下の追従ボタン（メニューはボタンの上に開く）。section：トップの Ask AI 節のボタン（メニューはボタンの下に開く） */
  variant: 'fab' | 'section';
}
const { variant } = Astro.props;
const prompt = buildAskPrompt(Astro.site);
const links = chatLinks(prompt).filter((l) => l.href);
/** メニューの id。1 ページに fab と section が 1 つずつまでなので、variant で分ければ重ならない */
const menuId = `ask-menu-${variant}`;
---

<div class:list={['ask-entry', `ask-entry-${variant}`]}>
  <button
    type="button"
    class:list={['ask-trigger', variant === 'fab' ? 'ask-fab' : 'button button-primary']}
    popovertarget={menuId}
  >
    {ASK_BUTTON_LABEL}
  </button>
  <div id={menuId} class="ask-menu" popover>
    <ul class="ask-menu-panel">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            data-ask-copy={l.copy ? prompt : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="ask-menu-more">
        <a href="/ask">プロンプトを見る</a>
      </li>
    </ul>
  </div>
</div>

<script>
  // 「Gemini（コピーして貼り付け）」を押したら、Gemini を新しいタブで開くのと同時にプロンプトをクリップボードへ写す。
  // 写せなかったときは、その旨と /ask でコピーできることをリンクの文字で知らせる（黙って失敗させない）
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-ask-copy]')) {
    const original = link.textContent ?? '';
    const fail = (error: unknown) => {
      console.error('プロンプトをコピーできませんでした', error);
      link.textContent = 'コピーできませんでした。/ask でコピーしてください';
    };
    link.addEventListener('click', () => {
      try {
        navigator.clipboard
          .writeText(link.dataset.askCopy ?? '')
          .then(() => {
            link.textContent = 'コピーしました。Gemini に貼り付けてください';
            setTimeout(() => (link.textContent = original), 4000);
          })
          .catch(fail);
      } catch (error) {
        // navigator.clipboard が無い環境（http で開いたときなど）はここに来る
        fail(error);
      }
    });
  }
</script>
