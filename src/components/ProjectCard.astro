---
// 一覧に出すプロジェクト 1 件のカード（SPEC.md §4）。上段に期間と区分、続けて題名・一文、下端にリンクを定位置に置く。
// 一文は tagline。summary（1〜2 文）は詳細ページと Markdown 版に任せ、カードには出さない。
// コードを AI が書いた作品（vibeCoding）は、一文の下に備考を 1 行添える。
// 親は <ul class="card-grid">。
import type { Project } from '../lib/content';
import { visibilityLabel, statusLabel, VIBE_CODING_NOTE } from '../lib/content';

interface Props {
  project: Project;
  /** true なら技術タグを省略する（トップの短い一覧向け） */
  compact?: boolean;
  /** true なら広い画面（トップの Projects が 3 列のとき）だけ出す。それより狭い画面では CSS で隠す */
  wideOnly?: boolean;
}
const { project, compact = false, wideOnly = false } = Astro.props;
const d = project.data;
const hasDetail = (project.body ?? '').trim().length > 0;
---

<li class:list={['card', { 'wide-only': wideOnly }]}>
  <div class="card-top">
    {d.period && <span>{d.period}</span>}
    <span class="card-badges">
      <span class="badge">{visibilityLabel[d.visibility]}</span>
      <span class="badge">{statusLabel[d.status]}</span>
    </span>
  </div>
  <h3>{hasDetail ? <a href={`/projects/${project.id}`}>{d.title}</a> : d.title}</h3>
  <p>{d.tagline}</p>
  {d.vibeCoding && <p class="card-note">{VIBE_CODING_NOTE}</p>}
  {!compact && d.stack.length > 0 && (
    <ul class="tag-list" aria-label="主要技術">
      {d.stack.map((s) => (
        <li>{s}</li>
      ))}
    </ul>
  )}
  {(d.repo || d.site) && (
    <div class="card-links">
      {d.repo && <a href={d.repo}>GitHub</a>}
      {d.site && <a href={d.site}>サイト</a>}
    </div>
  )}
</li>
